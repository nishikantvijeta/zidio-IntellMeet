# Server Configuration
PORT=5000

# MongoDB (optional - app falls back to in-memory store if unavailable)
MONGODB_URI=mongodb://localhost:27017/intellmeet

# JWT Secrets (generate your own for production)
JWT_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here

# Cloudinary Storage (optional - for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# AI Engine (optional - falls back to local NLP heuristics)
# Use either OpenAI OR Gemini API key
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_NAME=gemini-2.5-flash

# SMTP Mail (optional - falls back to console output)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="IntellMeet <no-reply@yourdomain.com>"
